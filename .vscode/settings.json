{
    "files.eol": "\n",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "explorerSort.defaultSort": "name",
    "explorerSort.respectGitignore": true,
    "explorerSort.rules": [
        {
            "name": "TSX before styles, folders first",
            "pathPattern": "**",
            "priorities": [
                {
                    "condition": "type === 'directory'",
                    "priority": 1000
                },
                {
                    "condition": "name.endsWith('.tsx')",
                    "priority": 100
                },
                {
                    "condition": "name.endsWith('.ts')",
                    "priority": 90
                },
                {
                    "condition": "name.endsWith('.module.less')",
                    "priority": 50
                },
                {
                    "condition": "name.endsWith('.less')",
                    "priority": 40
                }
            ]
        }
    ]
}
